APP_NAME=DongneMarket
DEBUG=True
# DEBUG일 때 기본 true. 목록에서 "E2E "로 시작하는 테스트 상품 숨김 (false면 purge 스크립트로 DB 정리)
# HIDE_E2E_TEST_ITEMS_IN_LIST=true
JWT_SECRET=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAILS=admin@example.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=market
BOOTSTRAP_DEV_DATA=True
BOOTSTRAP_WITH_ITEMS=True
